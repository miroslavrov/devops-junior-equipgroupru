[mysqld]
server-id = 2
log-bin = mariadb-bin
log_slave_updates = ON
relay-log = mariadb-relay-bin
read_only = 1
skip_slave_start = 1

bind-address = 0.0.0.0
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

max_connections = 200
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
